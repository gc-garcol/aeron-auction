# Makes IntelliJ's formatter follow config/checkstyle/checkstyle.xml. Checkstyle still enforces the rules in every build.
root = true

[*.java]
charset = utf-8
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 120
trim_trailing_whitespace = true
insert_final_newline = true
ij_continuation_indent_size = 4

# LeftCurly: braces go on their own line.
ij_java_block_brace_style = next_line
ij_java_class_brace_style = next_line
ij_java_method_brace_style = next_line
ij_java_lambda_brace_style = next_line
ij_java_keep_simple_blocks_in_one_line = false
ij_java_keep_simple_methods_in_one_line = false
ij_java_keep_simple_classes_in_one_line = false
ij_java_keep_simple_lambdas_in_one_line = false
ij_java_keep_control_statement_in_one_line = false

# RightCurly: closing braces stand alone.
ij_java_else_on_new_line = true
ij_java_catch_on_new_line = true
ij_java_finally_on_new_line = true
ij_java_while_on_new_line = true

# NeedBraces
ij_java_if_brace_force = always
ij_java_for_brace_force = always
ij_java_while_brace_force = always
ij_java_do_while_brace_force = always

# OperatorWrap: operators stay at the end of the line.
ij_java_binary_operation_sign_on_next_line = false
ij_java_ternary_operation_signs_on_next_line = false

# Indentation (strict) and SingleSpaceSeparator: no column alignment.
ij_java_indent_case_from_switch = true
ij_java_align_multiline_parameters = false
ij_java_align_multiline_parameters_in_calls = false
ij_java_align_multiline_binary_operation = false
ij_java_align_multiline_ternary_operation = false
ij_java_align_multiline_chained_methods = false
ij_java_align_multiline_assignment = false
ij_java_align_multiline_extends_list = false
ij_java_align_multiline_throws_list = false
ij_java_align_multiline_for = false
ij_java_align_multiline_array_initializer_expression = false
ij_java_align_multiline_resources = false
ij_java_align_multiline_records = false

# NoWhitespaceAfter: (int)value, with no space after the cast.
ij_java_space_after_type_cast = false

# FinalParameters and FinalLocalVariable: generated code uses final.
ij_java_generate_final_parameters = true
ij_java_generate_final_locals = true

# EmptyLineSeparator, and the blank lines already used in this project.
ij_java_blank_lines_around_method = 1
ij_java_keep_blank_lines_in_code = 1
ij_java_keep_blank_lines_in_declarations = 1

# Keeps explicit imports, which UnusedImports and RedundantImport can check.
ij_java_class_count_to_use_import_on_demand = 999
ij_java_names_count_to_use_import_on_demand = 999

# Leaves one-line Javadoc comments on one line.
ij_java_doc_do_not_wrap_if_one_line = true
